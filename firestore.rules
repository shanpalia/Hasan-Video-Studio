rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isHasanAdmin() {
      return request.auth != null
        && request.auth.token.email == "shanpalia786@gmail.com";
    }

    // Public website visitors can only read templates that are published.
    match /hasan_templates/{templateId} {
      allow read: if (resource.data.published == true) || isHasanAdmin();
      allow create, update, delete: if isHasanAdmin();
    }
  }
}